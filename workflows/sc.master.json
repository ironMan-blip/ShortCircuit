    {
      "name": "Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// No node reads the agent's tool steps to see whether an action tool succeeded.\nconst r = $input.first().json;\n// the agent may put a sub-node error (Gemini down, bad key) on its main output\nif (r.error || !r.output) return [{ json: { acted: false, output: { skipped: 'down', detail: String(r.error?.message ?? r.error ?? 'no answer').slice(0, 500) }, tools: [] } }];\nconst steps = r.intermediateSteps ?? [];\nconst acts = steps.filter((s) => ['retry_job', 'redo_job', 'fail_job', 'reject_job'].includes(s.action?.tool));\nconst done = acts.some((s) => /^\\s*(\\[\\s*\\{.*)?\"?done:/s.test(typeof s.observation === 'string' ? s.observation : JSON.stringify(s.observation)) || /done: SC-/.test(JSON.stringify(s.observation)));\nreturn [{ json: { acted: done, output: r.output ?? null, tools: steps.map((s) => ({ tool: s.action?.tool, input: s.action?.toolInput, result: String(typeof s.observation === 'string' ? s.observation : JSON.stringify(s.observation)).slice(0, 500) })) } }];"
      },
      "id": "c89e72d4-229b-1879-eb66-0d52fdd88200",
      "position": [
