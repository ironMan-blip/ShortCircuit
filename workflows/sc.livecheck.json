    {
      "name": "Jobs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, status, youtube_id, channel_id, slot_at, slot_date, drive_file_id, script->>'title' AS title, 'SC-' || lpad(id::text, 4, '0') AS job\nFROM jobs WHERE status NOT IN ('done', 'failed') OR (youtube_id IS NULL AND updated_at > now() - interval '30 days');",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "scCredPostgres01",
          "name": "SC Postgres"
        }
      },
      "alwaysOutputData": true,
      "executeOnce": true,
      "id": "a230792b-9216-080e-5abf-0b1747c6a1a5",
      "position": [
        1560,
        0
      ]
    },
    {
      "name": "Match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// No node matches videos to jobs by a hidden tag and decides each job's next state.\nconst ch = $('Channel').first().json.channel_id;\nconst vids = ($('Videos').first().json.items ?? []).filter((v) => v.snippet?.channelId === ch);\nconst jobs = $input.all().map((i) => i.json).filter((j) => j.id);\nconst byTag = new Map(); const byTitle = new Map();\nfor (const v of vids) { for (const t of v.snippet.tags ?? []) { const m = /^sc-([0-9]{4,})$/i.exec(t); if (m) byTag.set(Number(m[1]), v); } byTitle.set(String(v.snippet.title).trim(), v); }\nconst acts = [];\nfor (const j of jobs) {\n  const v = byTag.get(j.id) ?? (j.title ? byTitle.get(String(j.title).trim()) : undefined);\n  const ours = !j.channel_id || j.channel_id === ch;\n  if (j.status === 'awaiting_upload' && v) acts.push({ type: 'scheduled', id: j.id, youtube_id: v.id });\n  else if (v && !j.youtube_id && j.status !== 'awaiting_upload') acts.push({ type: 'save_id', id: j.id, youtube_id: v.id, job: j.job, status: j.status });\n  if (j.status === 'scheduled' && ours && j.youtube_id) {\n    const sv = vids.find((x) => x.id === j.youtube_id) ?? v;\n    if (sv && sv.status?.privacyStatus === 'public') acts.push({ type: 'live', id: j.id });\n    else if (!sv) acts.push({ type: 'gone_check', id: j.id, youtube_id: j.youtube_id });\n  }\n}\nconst stats = vids.map((v) => ({ id: v.id, views: Number(v.statistics?.viewCount ?? 0), likes: Number(v.statistics?.likeCount ?? 0), comments: Number(v.statistics?.commentCount ?? 0) }));\nreturn [{ json: { acts, stats } }];"
      },
      "id": "26cd9e73-1b3c-da21-446e-09db90b8267d",
      "position": [
        1820,
        0
      ]
