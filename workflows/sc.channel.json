    {
      "name": "Compare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// No node compares two API results and picks one of three outcomes.\nconst want = $('Handle channel').first().json.items?.[0]?.id ?? null;\nconst have = $('Credential channel').first().json.items?.[0]?.id ?? null;\nconst handle = $('Check handle').first().json.handle;\nif (!want) return [{ json: { ok: false, reason: 'handle_not_found', alert: { key: 'handle_not_found', subject: 'No channel has the handle ' + handle,\n  text: 'YouTube finds no channel for CHANNEL_HANDLE \"' + handle + '\" (exactly as written in .env). Fix the value in .env; nothing is uploaded until then.' } } }];\nif (want !== have) return [{ json: { ok: false, reason: 'channel_mismatch', alert: { key: 'channel_mismatch', subject: 'YouTube credential is for another channel',\n  text: 'The YouTube Channel credential is connected to channel ' + have + ', but ' + handle + ' is channel ' + want + '. Nothing was uploaded. Re-connect the credential to ' + handle + ' or fix CHANNEL_HANDLE.' } } }];\nreturn [{ json: { ok: true, channel_id: want } }];"
      },
