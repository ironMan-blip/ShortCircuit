    {
      "name": "Top up",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH c AS (\n  SELECT count(*) FILTER (WHERE status IN ('video_review', 'video_editing', 'approved', 'awaiting_upload', 'scheduled'))::int AS buffer,\n         count(*) FILTER (WHERE status IN ('new', 'script_review', 'needs_human', 'revising', 'script_approved'))::int AS pipeline\n  FROM jobs),\nins AS (\n  INSERT INTO jobs (status)\n  SELECT 'new' FROM c, generate_series(1, GREATEST(0, LEAST(2, $1::int - c.buffer - c.pipeline)))\n  RETURNING id)\nSELECT c.buffer, c.pipeline, (SELECT count(*) FROM ins)::int AS inserted FROM c;",
        "options": {
          "queryReplacement": "={{ [Number($env.BUFFER_TARGET ?? 4)] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "scCredPostgres01",
          "name": "SC Postgres"
        }
      },
      "id": "1b4b36a3-865a-c980-c606-d95dbe60697d",
      "position": [
        260,
        0
      ]
    },
