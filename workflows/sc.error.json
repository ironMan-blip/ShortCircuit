    {
      "name": "Count failures",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// No node keeps a rolling count across executions: workflow static data does.\nconst e = $input.first().json;\nconst wf = e.workflow?.name ?? 'unknown';\n// sc.llm throws on purpose when a whole chain fails; its caller's fail branch handles that (attempts → triage).\nif (wf === 'sc.llm') return [];\nconst s = $getWorkflowStaticData('global');\nconst now = Date.now();\ns.fails = (s.fails ?? {});\ns.fails[wf] = (s.fails[wf] ?? []).filter((t) => now - t < 3600e3).concat(now);\nconst msg = String(e.execution?.error?.message ?? e.trigger?.error?.message ?? 'unknown error').slice(0, 500);\nconst node = e.execution?.lastNodeExecuted ?? '';\nif (s.fails[wf].length < 3) return [];\ns.fails[wf] = [];\nreturn [{ json: { key: 'workflow_failing:' + wf, subject: wf + ' failed 3 times in an hour',\n  text: 'Workflow ' + wf + ' failed 3 times in the last hour. Last failure at node \"' + node + '\": ' + msg + (e.execution?.url ? '\\nExecution: ' + e.execution.url : '') } }];"
      },
      "id": "176568a9-ba3a-fc8a-5106-759fdd80347a",
      "position": [
        260,
        0
      ]
    },
