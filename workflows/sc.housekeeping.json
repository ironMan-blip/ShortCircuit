      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (SELECT value FROM config_seen WHERE key = 'drive_ready') AS folder_id,\n  coalesce((SELECT json_agg(drive_file_id) FROM jobs WHERE drive_file_id IS NOT NULL AND status NOT IN ('cancelled', 'rejected', 'failed', 'done')), '[]'::json) AS keep;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "scCredPostgres01",
          "name": "SC Postgres"
        }
