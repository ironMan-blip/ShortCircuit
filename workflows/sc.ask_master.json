        "jsCode": "// No node checks the task name and builds the per-task settings.\nconst i = $input.first().json;\nconst schemas = { review_script: \"{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"verdict\\\":{\\\"type\\\":\\\"string\\\",\\\"enum\\\":[\\\"ok\\\",\\\"redo\\\"]},\\\"score\\\":{\\\"type\\\":\\\"integer\\\",\\\"minimum\\\":1,\\\"maximum\\\":10},\\\"issues\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\"}},\\\"feedback\\\":{\\\"type\\\":\\\"string\\\"}},\\\"required\\\":[\\\"verdict\\\",\\\"score\\\",\\\"issues\\\",\\\"feedback\\\"]}\", review_video: \"{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"verdict\\\":{\\\"type\\\":\\\"string\\\",\\\"enum\\\":[\\\"ok\\\",\\\"redo\\\"]},\\\"score\\\":{\\\"type\\\":\\\"integer\\\",\\\"minimum\\\":1,\\\"maximum\\\":10},\\\"issues\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"string\\\"}},\\\"feedback\\\":{\\\"type\\\":\\\"string\\\"}},\\\"required\\\":[\\\"verdict\\\",\\\"score\\\",\\\"issues\\\",\\\"feedback\\\"]}\", diagnose_grade: \"{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"agents\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"agent\\\":{\\\"type\\\":\\\"string\\\"},\\\"status\\\":{\\\"type\\\":\\\"string\\\",\\\"enum\\\":[\\\"good\\\",\\\"weak\\\",\\\"failing\\\"]},\\\"score\\\":{\\\"type\\\":\\\"integer\\\",\\\"minimum\\\":1,\\\"maximum\\\":10},\\\"best_provider\\\":{\\\"type\\\":\\\"string\\\"},\\\"notes\\\":{\\\"type\\\":\\\"string\\\"}},\\\"required\\\":[\\\"agent\\\",\\\"status\\\",\\\"score\\\",\\\"best_provider\\\",\\\"notes\\\"]}},\\\"candidates\\\":{\\\"type\\\":\\\"array\\\",\\\"items\\\":{\\\"type\\\":\\\"object\\\",\\\"properties\\\":{\\\"model\\\":{\\\"type\\\":\\\"string\\\"},\\\"agent\\\":{\\\"type\\\":\\\"string\\\"},\\\"better\\\":{\\\"type\\\":\\\"boolean\\\"},\\\"evidence\\\":{\\\"type\\\":\\\"string\\\"}},\\\"required\\\":[\\\"model\\\",\\\"agent\\\",\\\"better\\\",\\\"ev