    {
      "name": "Map error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// No node maps an API or parser error to one reason code.\nconst e = $input.first().json; const m = String(e.error?.message ?? e.error ?? e.message ?? 'error') + ' ' + String(e.error?.description ?? '');\nconst reason = /401|403|invalid x-api-key|api key|authentication|permission/i.test(m) ? 'auth'\n  : /429|rate.?limit|spend|credit balance|usage limit|quota/i.test(m) ? 'limit'\n  : /timeout|timed out|ETIMEDOUT|ECONNABORTED/i.test(m) ? 'timeout'\n  : /parse|schema|output parser|JSON|format/i.test(m) ? 'invalid' : 'down';\nreturn [{ json: { ok: false, reason, detail: m.slice(0, 500) } }];"
      },
      "id": "7620551d-30f4-2eab-021b-93c4a4a08743",
      "position": [
        2080,
        0
      ]
    },
    {
      "name": "Check verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The Master's output is untrusted even when it parses: check enums and names in code.\nconst o = $input.first().json.output ?? {}; const task = $('Task').first().json.task;\nconst bad = (why) => [{ json: { ok: false, reason: 'invalid', detail: why } }];\nif (task === 'diagnose_grade') {\n  const agents = (o.agents ?? []).filter((a) => [\"scout\",\"writer\",\"checker\",\"editor\",\"director\",\"cutter\",\"scheduler\"].includes(a.agent) && ['good', 'weak', 'failing'].includes(a.status));\n  const candidates = (o.candidates ?? []).filter((c) => /^(gemini|groq|ollama):[A-Za-z0-9._:\\/-]{1,100}$/.test(c.model) && [\"scout\",\"writer\",\"checker\",\"editor\",\"director\",\"cutter\",\"scheduler\"].includes(c.agent));\n  return [{ json: { ok: true, json: { agents, candidates, report: String(o.report ?? '').slice(0, 4000) }, model: $env.MASTER_MODEL } }];\n}\nif (!['ok', 'redo'].includes(o.verdict)) return bad('verdict is not ok/redo');\nconst score = Math.max(1, Math.min(10, Math.round(Number(o.score) || 1)));\nreturn [{ json: { ok: true, json: { verdict: o.verdict, score, issues: (o.issues ?? []).map(String).slice(0, 10), feedback: String(o.feedback ?? '').slice(0, 1500) }, model: $env.MASTER_MODEL } }];"
      },
      "id": "060ba4eb-a60e-31b6-f102-2b6e93d28628",
      "position": [
        2080,
        220
      ]
    },
    {
      "name": "Build request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// No node builds a Messages API body with server-side web tools (the contrast lesson, PLAN §5.1).\nconst DIAG_WEB_DOMAINS = [\"ai.google.dev\",\"groq.com\",\"console.groq.com\",\"ollama.com\",\"huggingface.co\",\"github.com\",\"lmarena.ai\",\"artificialanalysis.ai\"];\nconst ctx = String($('Task').first().json.context).replace(/<\\/?context\\b/gi, '[tag]');\nconst body = { model: $env.MASTER_MODEL, max_tokens: 32000, output_config: { effort: 'high' },\n  // server-side fallback on a refusal (claude-api default for Opus 5.5)\n  fallbacks: 'default',\n  system: $('Prompt text').first().json.prompt,\n  messages: [{ role: 'user', content: [{ type: 'text', text: '<context>\\n' + ctx + '\\n</context>' }] }],\n  tools: [{ type: 'web_search_20260209', name: 'web_search', max_uses: 10, allowed_domains: DIAG_WEB_DOMAINS },\n          { type: 'web_fetch_20260209', name: 'web_fetch', max_uses: 10, allowed_domains: DIAG_WEB_DOMAINS }] };\nreturn [{ json: { body, resumes: 0, retries: 0, searches: 0, input_tokens: 0, output_tokens: 0 } }];"
      },
      "id": "068d31b8-9bdd-2883-1942-341cfc7a9db5",
      "position": [
        1560,
        220
      ]
