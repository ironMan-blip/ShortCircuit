    {
      "name": "Verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// No node merges the Checker's JSON with the code rule checks.\nconst c = $input.first().json;\nconst rules = $('Rules').first().json.rules;\nconst script = $('Editor').first().json.json;\nconst pass = c.json?.pass === true && rules.length === 0;\nconst flags = [...(c.json?.unsupported_claims ?? []), ...(c.json?.policy_issues ?? []), ...rules].map(String);\nreturn [{ json: { script, check: { ...c.json, rules, pass }, pass, flags,\n  writer_agent: 'editor', writer_provider: $('Editor').first().json.provider, checker_provider: c.provider } }];"
