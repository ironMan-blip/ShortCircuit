    {
      "name": "Rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// No node counts words or checks fact ids against the brief.\nconst s = $('Editor').first().json.json;\nconst brief = $('Claim').first().json.brief;\nconst words = (s.scenes ?? []).map((x) => x.narration ?? '').join(' ').split(/\\s+/).filter(Boolean).length;\nconst rules = [];\nif (words < 90 || words > 140) rules.push('narration is ' + words + ' words; it must be 90-140');\nif (String(s.title ?? '').length > 70) rules.push('title is longer than 70 characters');\nconst nf = (brief.facts ?? []).length;\nfor (const sc of s.scenes ?? []) for (const f of sc.fact_ids ?? []) if (!(Number.isInteger(f) && f >= 0 && f < nf)) rules.push('scene ' + sc.id + ' cites fact ' + f + ', which the brief does not have');\nreturn [{ json: { rules, words } }];"
      },
      "id": "aeba6710-5735-8eeb-d77f-d6190ee408de",
