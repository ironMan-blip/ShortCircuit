    {
      "name": "Snapshot",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT jsonb_build_object(\n  'now', now(),\n  'jobs_per_status', (SELECT coalesce(jsonb_object_agg(status, c), '{}') FROM (SELECT status, count(*) c FROM jobs WHERE status NOT IN ('done', 'failed', 'cancelled', 'rejected') OR updated_at > now() - interval '24 hours' GROUP BY status) s),\n  'errors_24h', (SELECT coalesce(jsonb_agg(e), '[]') FROM (SELECT 'SC-' || lpad(id::text, 4, '0') AS job, status, attempts, left(last_error, 300) AS error FROM jobs WHERE last_error IS NOT NULL AND updated_at > now() - interval '24 hours' ORDER BY updated_at DESC LIMIT 20) e),\n  'buffer', (SELECT count(*) FROM jobs WHERE slot_at > now() AND status IN ('video_review', 'video_editing', 'approved', 'awaiting_upload', 'scheduled')),\n  'empty_slot_days', (SELECT coalesce(jsonb_agg(to_char(d, 'YYYY-MM-DD')), '[]') FROM generate_series((now() AT TIME ZONE $1)::date + 1, (now() AT TIME ZONE $1)::date + 3, interval '1 day') d WHERE d::date NOT IN (SELECT slot_date FROM jobs WHERE slot_date IS NOT NULL)),\n  'schedule', (SELECT coalesce(jsonb_object_agg(dow, to_char(publish_time, 'HH24:MI')), '{}') FROM schedule),\n  'schedule_changed_today', EXISTS (SELECT 1 FROM master_log WHERE task = 'schedule' AND created_at > now() - interval '24 hours' AND result->>'changed' = 'true'),\n  'config_changed_today', EXISTS (SELECT 1 FROM master_log WHERE task = 'config' AND created_at > now() - interval '24 hours'),\n  'master_log_today', (SELECT coalesce(jsonb_agg(jsonb_build_object('job', CASE WHEN job_id IS NULL THEN NULL ELSE 'SC-' || lpad(job_id::text, 4, '0') END, 'task', task, 'result', result) ORDER BY id), '[]') FROM (SELECT * FROM master_log WHERE created_at > now() - interval '24 hours' AND task <> 'daily' ORDER BY id DESC LIMIT 40) m)\n) AS snapshot;",
        "options": {
          "queryReplacement": "={{ [$env.TZ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "scCredPostgres01",
          "name": "SC Postgres"
        }
      },
      "id": "d5686fe3-cc01-4d66-2823-efede6b7f48a",
      "position": [
        260,
        0
      ]
    },
    {
      "name": "Crew stats",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH d AS (SELECT LEAST(30, GREATEST(1, coalesce($1, 7))) AS days),\nj AS (SELECT * FROM jobs, d WHERE created_at > now() - make_interval(days => d.days) OR updated_at > now() - make_interval(days => d.days))\nSELECT jsonb_build_object(\n  'days', (SELECT days FROM d),\n  'jobs_per_status', (SELECT coalesce(jsonb_object_agg(status, c), '{}') FROM (SELECT status, count(*) c FROM j GROUP BY status) s),\n  'provider_use', (SELECT coalesce(jsonb_object_agg(agent, p), '{}') FROM (SELECT agent, jsonb_object_agg(provider, c) p FROM (SELECT k AS agent, v AS provider, count(*) c FROM j, jsonb_each_text(j.providers) e(k, v) GROUP BY 1, 2) x GROUP BY agent) y),\n  'checker_flag_rate', (SELECT round(avg(CASE WHEN (check_result->>'pass')::boolean THEN 0 ELSE 1 END)::numeric, 2) FROM j WHERE check_result IS NOT NULL),\n  'needs_human', (SELECT count(*) FROM j WHERE status = 'needs_human'),\n  'master', (SELECT coalesce(jsonb_object_agg(task, c), '{}') FROM (SELECT task || CASE WHEN result ? 'skipped' THEN ':skipped' WHEN result->>'verdict' = 'redo' THEN ':redo' ELSE '' END AS task, count(*) c FROM master_log, d WHERE created_at > now() - make_interval(days => d.days) GROUP BY 1) m),\n  'owner_decisions', (SELECT coalesce(jsonb_object_agg(decision, c), '{}') FROM (SELECT kind || ':' || decision AS decision, count(*) c FROM reviews, d WHERE answered_at > now() - make_interval(days => d.days) GROUP BY 1) r),\n  'errors', (SELECT coalesce(jsonb_agg(e), '[]') FROM (SELECT 'SC-' || lpad(id::text, 4, '0') AS job, status, left(last_error, 300) AS error FROM j WHERE last_error IS NOT NULL ORDER BY updated_at DESC LIMIT 20) e),\n  'views_48h', (SELECT coalesce(jsonb_agg(jsonb_build_object('job', 'SC-' || lpad(m.job_id::text, 4, '0'), 'views', m.views)), '[]') FROM metrics m, d WHERE m.age_h = 48 AND m.taken_at > now() - make_interval(days => d.days))\n) AS result;",
        "options": {
          "queryReplacement": "={{ [1] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "scCredPostgres01",
          "name": "SC Postgres"
        }
      },
