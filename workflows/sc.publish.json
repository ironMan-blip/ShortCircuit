    {
      "name": "Pack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// No node builds the upload pack (escaping, links, metadata).\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst job = (id) => 'SC-' + String(id).padStart(4, '0');\n// The Code node sandbox has no URL class: a strict https parser (no userinfo, no IP literal, dotted host).\nconst okUrl = (u) => { const m = /^https:\\/\\/([a-z0-9-]+(?:\\.[a-z0-9-]+)+)(:[0-9]{1,5})?([/?#][^\\s\"'<>\\\\]*)?$/i.exec(String(u ?? '').trim());\n  if (!m || /^[0-9.]+$/.test(m[1])) return null; const rest = m[3] ?? '/'; return 'https://' + m[1].toLowerCase() + (m[2] ?? '') + (rest[0] === '/' ? rest : '/' + rest); };\nconst hostOf = (u) => { const x = okUrl(u); return x ? x.slice(8).split(/[/:?#]/)[0] : null; };\nconst fmt = (t) => t ? new Date(t).toLocaleString('en-GB', { timeZone: $env.TZ, weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '(no slot yet)';\nconst page = (title, body) => '<div style=\"font-family:system-ui,sans-serif;max-width:640px\">' + '<h2 style=\"margin:0 0 12px\">' + esc(title) + '</h2>' + body + '</div>';\nconst button = (href, label) => okUrl(href) ? '<p><a href=\"' + esc(okUrl(href)) + '\" style=\"display:inline-block;padding:10px 18px;background:#111;color:#fff;border-radius:6px;text-decoration:none\">' + esc(label) + '</a></p>' : '';\nconst cancelLink = (id) => button($env.WEBHOOK_URL + 'form/sc-cancel?Job=' + job(id), 'Cancel this video');\n\nconst desc = (s, b) => String(s.description ?? '').replace(/(https?:\\/\\/|www\\.)\\S+/gi, '').replace(/\\b[a-z0-9-]+(\\.[a-z0-9-]+)+\\/\\S*/gi, '').replace(/[ \\t]+\\n/g, '\\n').trim()\n  + '\\n\\nSources:\\n' + (b.checked_urls ?? []).map(okUrl).filter(Boolean).join('\\n') + '\\n\\n#Shorts';\nconst tags = (s, id) => [...new Set([...(s.tags ?? []).map((t) => String(t).replace(/[<>,\"]/g, '').trim()).filter(Boolean).slice(0, 12), 'sc-' + String(id).padStart(4, '0')])];\n\nconst jobs = $input.all().map((i) => i.json).filter((j) => j.id);\nif (!jobs.length) return [];\nconst soon = jobs.some((j) => new Date(j.slot_at).getTime() < Date.now() + 36 * 3600e3);\nif (jobs.length < 3 && !soon) return [];\nconst rows = jobs.map((j) => {\n  const late = new Date(j.slot_at).getTime() < Date.now();\n  return '<hr><h3>' + esc(j.job) + ' · ' + esc(j.script?.title) + '</h3>' + button(j.drive_link, 'Download from Drive')\n    + '<p><b>Publish:</b> ' + (late ? '<b>slot passed: publish now</b>' : esc(fmt(j.slot_at))) + '</p>'\n    + '<p><b>Title</b><br>' + esc(j.script?.title) + '</p><p><b>Description</b><br><span style=\"white-space:pre-wrap\">' + esc(desc(j.script ?? {}, j.brief ?? {})) + '</span></p>'\n    + '<p><b>Tags</b> (paste exactly, the sc- tag included)<br>' + esc(tags(j.script ?? {}, j.id).join(', ')) + '</p>';\n}).join('');\nconst html = page('Upload pack — ' + jobs.length + ' videos', '<p>Upload to <b>' + esc($env.CHANNEL_HANDLE) + '</b> in YouTube Studio and schedule each one at its time. Category: Science &amp; Technology; not made for kids.</p>' + rows);\nreturn [{ json: { ids: jobs.map((j) => j.id), first: jobs[0].id, outbox: { subject: 'ShortCircuit upload pack — ' + jobs.length + ' videos', html } } }];"
      },
      "id": "ded5be11-baba-5edb-afad-54d3f21a2b0c",
      "position": [
