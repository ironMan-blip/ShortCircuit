      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// No node checks a form value against a pattern.\nconst raw = String($input.first().json.Job ?? '').trim();\nconst m = /^SC-([0-9]{4,9})$/.exec(raw);\nreturn [{ json: { ok: !!m, id: m ? Number(m[1]) : null, job: raw.slice(0, 20) } }];"
