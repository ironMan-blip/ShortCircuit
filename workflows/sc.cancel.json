    {
      "name": "Cancel",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH u AS (\n  UPDATE jobs SET status = 'cancelled', slot_at = NULL, slot_date = NULL, review_url = NULL, updated_at = now()\n  WHERE id = $1 AND status IN ('new', 'script_review', 'needs_human', 'revising', 'script_approved', 'video_review', 'video_editing', 'approved', 'awaiting_upload', 'scheduled', 'triage') RETURNING id),\nins AS (\n  INSERT INTO reviews (execution_id, job_id, kind, decision)\n  SELECT $2, $1, 'cancel', 'cancel' WHERE EXISTS (SELECT 1 FROM u) ON CONFLICT DO NOTHING)\nSELECT (SELECT count(*) FROM u)::int AS cancelled, (SELECT status FROM jobs WHERE id = $1) AS status;",
        "options": {
          "queryReplacement": "={{ [$json.id, $execution.id] }}",
          "queryBatching": "transaction"
        }
      },
