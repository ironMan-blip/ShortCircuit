# ShortCircuit settings (docs/PLAN.md §1, §16). Copy to .env and fill in.
# n8n never reads this file: scripts/apply-env.sh checks every save and writes the
# checked copy state/.env.live, which is what the containers get.
# Format: KEY=value, one per line, no quotes, no spaces around =, no $ or \ in values.

# --- The two fixed targets: write them exactly; nothing ever corrects them ---
# One plain address. The only address mail is ever sent to.
OWNER_EMAIL=you@example.com
# The handle exactly as the channel page shows it, @ included.
CHANNEL_HANDLE=@shortcircuittech
# The bot Gmail account that sends mail and holds the Drive folder.
BOT_EMAIL=shortcircuit.bot@example.com

# --- Time and publishing ---
# A zoneinfo zone. GENERIC_TIMEZONE for n8n is set from it by apply-env.sh.
TZ=Asia/Dhaka
# Used until the Scheduler has written the schedule table. HH:MM in TZ.
PUBLISH_TIME=18:00
SCHEDULE_CANDIDATES=12:00,15:00,18:00,21:00
# manual until the YouTube API audit passes, then auto (§8).
PUBLISH_MODE=manual
BUFFER_TARGET=4
# Script and video review limit in hours; NEEDS YOU waits 4 times as long. 1 for the M10 dry run.
REVIEW_HOURS=12

# The tailnet-only n8n address (tailscale serve), with the trailing /.
# N8N_EDITOR_BASE_URL is set from it by apply-env.sh.
WEBHOOK_URL=https://your-mac.your-tailnet.ts.net/

# --- Worker models (§4). Check ids and daily free limits at M0 ---
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=qwen3:8b

# Model chain per agent: comma list of gemini, groq, ollama, each optionally :<model id>.
# EDITOR and CUTTER get owner notes, so they may never name gemini (§4).
LLM_CHAIN_SCOUT=gemini,groq,ollama
LLM_CHAIN_WRITER=gemini,groq,ollama
LLM_CHAIN_CHECKER=groq,gemini,ollama
LLM_CHAIN_EDITOR=groq,ollama
LLM_CHAIN_DIRECTOR=ollama,gemini
LLM_CHAIN_CUTTER=ollama,groq
LLM_CHAIN_SCHEDULER=gemini,groq,ollama

# --- Master (§4.8). Gemini free tier, same Gemini credential as the workers (no card) ---
# Keep it different from GEMINI_MODEL: free quota is per model, so a shared model lets triage starve the workers.
MASTER_MODEL=gemini-2.5-flash-lite

# --- Secrets that a reload cannot change (apply-env.sh refuses a change) ---
# Encrypts n8n's stored credentials. Make with: openssl rand -hex 32. Back it up.
N8N_ENCRYPTION_KEY=
# Postgres superuser (n8n's own database). Make with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Role sc_app (database shortcircuit), used by the `SC Postgres` credential.
POSTGRES_APP_PASSWORD=
